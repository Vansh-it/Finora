---
import Layout from '../layouts/Layout.astro';
import FlowIndicator from '../components/ui/FlowIndicator.astro';
import { company, execSummary } from '../data/microsoft';

const params = Astro.url.searchParams;
const companyName = params.get('company') ?? company.name;
const from = params.get('from') ?? '2024';
const to = params.get('to') ?? '2025';
---

<Layout
  title={`Results — ${companyName}`}
  description="Executive summary, key findings, growth drivers, and risks for the researched company."
>
  <div class="mx-auto max-w-4xl px-6 py-16 md:px-8 md:py-24">
    <div class="flex justify-center">
      <FlowIndicator active={4} />
    </div>

    <div class="mt-12">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="font-mono text-caption-mono uppercase tracking-wide text-accent">// results</p>
          <h1 class="mt-3 text-display-lg text-ink">{companyName}</h1>
          <p class="mt-1 font-mono text-caption-mono text-mute">
            {company.ticker} · FY {from} – {to} · {company.fiscalPeriod}
          </p>
        </div>
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-ink text-body-sm-strong text-canvas">
          {company.logoInitials}
        </span>
      </div>

      <!-- Executive summary -->
      <section class="mt-10 rounded-lg bg-canvas p-7 shadow-l2 md:p-8">
        <h2 class="flex items-center gap-2 text-display-sm text-ink">
          <svg class="text-accent" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 2.5h7l3.5 3.5v11.5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-14a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M12 2.5V6h3.5M7 10.5h6M7 13.5h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Executive summary
        </h2>
        <p class="mt-4 text-body-md-strong text-ink">{execSummary.headline}</p>
        <p class="mt-3 text-body-sm text-body">{execSummary.body}</p>
      </section>

      <!-- Key findings -->
      <section class="mt-10">
        <h2 class="text-display-sm text-ink">Key findings</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {
            execSummary.keyFindings.map((f, i) => (
              <article class="rounded-lg bg-canvas p-6 shadow-l1">
                <p class="font-mono text-caption-mono text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</p>
                <h3 class="mt-3 text-body-sm-strong text-ink">{f.title}</h3>
                <p class="mt-2 text-body-sm text-body">{f.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <!-- Growth drivers -->
        <section class="rounded-lg bg-canvas p-6 shadow-l1">
          <h2 class="flex items-center gap-2 text-display-sm text-ink">
            <svg class="text-up" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M3 15.5h14M5 12l3.5-3.5 2.5 2.5L15 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M11.5 6.5H15V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Growth drivers
          </h2>
          <ul class="mt-4 space-y-3">
            {
              execSummary.growthDrivers.map((d) => (
                <li class="flex items-start gap-2.5 text-body-sm text-body">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-up" aria-hidden="true"></span>
                  {d}
                </li>
              ))
            }
          </ul>
        </section>

        <!-- Risks -->
        <section class="rounded-lg bg-canvas p-6 shadow-l1">
          <h2 class="flex items-center gap-2 text-display-sm text-ink">
            <svg class="text-warning" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 2.5l7.5 13h-15L10 2.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              <path d="M10 8v3.5M10 14.5h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            Risks
          </h2>
          <ul class="mt-4 space-y-3">
            {
              execSummary.risks.map((r) => (
                <li class="flex items-start gap-2.5 text-body-sm text-body">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-warning" aria-hidden="true"></span>
                  {r}
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <!-- CTAs -->
      <div class="mt-12 flex flex-col gap-3 sm:flex-row">
        <a
          href="/dashboard"
          class="inline-flex h-12 flex-1 items-center justify-center gap-2 rounded-pill bg-ink px-6 text-button-lg text-canvas transition-opacity hover:opacity-90"
        >
          View Dashboard
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href="/chat"
          class="inline-flex h-12 flex-1 items-center justify-center gap-2 rounded-pill border border-hairline bg-canvas px-6 text-button-lg text-ink transition-colors hover:bg-canvas-soft"
        >
          <svg width="15" height="15" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M3.5 2.5h11a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H7.5L4 15.5v-3H3.5a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
            <path d="M6 7h6M6 9.5h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          Ask Questions
        </a>
      </div>
    </div>
  </div>
</Layout>
