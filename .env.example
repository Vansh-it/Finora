[TEMPLATE]
# Finora Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# NVIDIA Nemotron 3.5 — the only LLM provider.
# Get your key at https://build.nvidia.com

NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Tavily Search ──────────────────────────────────────────────────────────────
# Web search API for research source discovery.
# Get your key at https://tavily.com

TAVILY_API_KEY=your_tavily_api_key_here

# ── Jina Reader ────────────────────────────────────────────────────────────────
# Web page content extraction for reading source documents.
# Get your key at https://jina.ai

JINA_API_KEY=your_jina_api_key_here

# ── SEC/EDGAR ─────────────────────────────────────────────────────────────────
# User-Agent string for SEC EDGAR requests.
# SEC requires a valid User-Agent header for automated access.
# Format: "AppName YourEmail@example.com"

FINORA_SEC_USER_AGENT=Finora Research Tool your_email@example.com

# ── Twelve Data ───────────────────────────────────────────────────────────────
# Stock market data API (prices, fundamentals, etc.).
# Get your key at https://twelvedata.com

TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ── Financial Modeling Prep (FMP) ───────────────────────────────────────────
# Structured financial enrichment + valuation/market support.
# Get your key at https://financialmodelingprep.com

FMP_API_KEY=your_fmp_api_key_here

# ── FRED (Federal Reserve Economic Data) ────────────────────────────────────
# Macroeconomic context (rates, CPI).
# Get your key at https://fred.stlouisfed.org/docs/api/api_key.html
# If missing, macro context is gracefully disabled.

FRED_API_KEY=your_fred_api_key_here

# ── Business Quant ────────────────────────────────────────────────────────────
# Structured financial data API — secondary fallback for missing SEC values.
# Get your key at https://businessquant.com

BUSINESS_QUANT_API_KEY=your_business_quant_api_key_here

# ── Backend URL ──────────────────────────────────────────────────────────────
# URL of the Flask research backend (required for Vercel deployment).
# Example: https://your-flask-backend.onrender.com

BACKEND_URL=

# ── Upstash Redis (Vercel Production) ────────────────────────────────────────
# Required for auth + session persistence on Vercel.
# Create a free Redis database at https://upstash.com
# Or via Vercel Marketplace > Storage > Redis

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Com comma-separated list of allowed frontend origins.
# Leave empty for development (defaults to localhost:4321).

CORS_ORIGINS=

# ── Flask ─────────────────────────────────────────────────────────────────────
# Set to "false" in production.
FLASK_DEBUG=true

# Server port (default 8000).
PORT=8000

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Multi-provider LLM access via OpenRouter (free tier models).
# Get your key at https://openrouter.ai

OPENROUTER_API_KEY=your_openrouter_api_key_here
