---
import Layout from '../layouts/Layout.astro';
import SignUpForm from '../components/auth/SignUpForm.tsx';
---

<Layout
  title="Sign Up"
  description="Create a free Finora account to start researching public companies."
>
  <div class="mx-auto max-w-md px-6 py-16 md:px-8 md:py-24">
    <div class="text-center">
      <p class="font-mono text-caption-mono uppercase tracking-wide text-accent">// sign up</p>
      <h1 class="mt-4 text-display-md text-ink text-balance">Create your account</h1>
      <p class="mt-3 text-body-sm text-body">
        Free research credits included. No credit card required.
      </p>
    </div>

    <div class="mt-10">
      <SignUpForm client:load />
    </div>

    <p class="mt-8 text-center text-caption text-mute">
      Already have an account?{' '}
      <a href="/signin" class="text-accent transition-colors hover:text-ink">
        Sign in
      </a>
    </p>
  </div>
</Layout>
