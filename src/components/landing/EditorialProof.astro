---
---

<section class="relative border-b border-ink/15">
  <div class="relative mx-auto max-w-[1440px] px-4 py-20 sm:px-6 lg:px-10">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-2">
      <div>
        <p class="mb-3 font-mono text-xs tracking-[0.25em] text-ink-3 uppercase">Transparency</p>
        <h2 class="font-serif text-3xl leading-[1.05] font-medium tracking-tight text-ink sm:text-4xl lg:text-5xl text-balance">
          Every number<br />
          <span class="mark-highlight">has a receipt.</span>
        </h2>
        <p class="mt-6 max-w-md text-base leading-relaxed text-ink-2">
          Finora doesn't just show you a metric — it shows the calculation, the underlying filing, and the
          exact XBRL concept that produced it. No black boxes.
        </p>
        <a
          href="/dashboard"
          class="mt-8 inline-flex items-center gap-2 border-b-2 border-ink pb-1 font-mono text-xs font-bold tracking-[0.15em] text-ink uppercase transition-colors hover:border-highlight"
        >
          See it in the dashboard &rarr;
        </a>
      </div>

      <div class="border border-ink/20 bg-paper p-6 sm:p-8">
        <div class="font-mono text-[10px] leading-tight tracking-[0.18em] uppercase">
          <div class="font-semibold text-ink-2">Metric</div>
          <div class="mt-0.5 text-ink-3">Free Cash Flow &middot; Apple Inc. &middot; FY2025</div>
        </div>

        <div class="mt-6 flex flex-col gap-4 font-mono text-sm">
          <div class="flex items-center justify-between border-b border-dashed border-ink/30 pb-3">
            <span class="text-ink-2">Operating Cash Flow</span>
            <span class="font-bold text-ink">$125.4B</span>
          </div>
          <div class="flex items-center justify-between border-b border-dashed border-ink/30 pb-3">
            <span class="text-ink-2">&minus; Capital Expenditure</span>
            <span class="font-bold text-ink">$16.6B</span>
          </div>
          <div class="flex items-center justify-between pt-1">
            <span class="font-semibold text-ink">= Free Cash Flow</span>
            <span class="mark-highlight font-mono text-lg font-bold">$108.8B</span>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-6 border-t border-ink/15 pt-6">
          <div class="font-mono text-[10px] leading-tight tracking-[0.18em] uppercase">
            <div class="font-semibold text-ink-2">Source</div>
            <div class="mt-0.5 text-ink-3">SEC 10-K, FY2025</div>
          </div>
          <div class="font-mono text-[10px] leading-tight tracking-[0.18em] uppercase max-w-[220px]">
            <div class="font-semibold text-annotate-blue">XBRL Concept</div>
            <div class="mt-0.5 text-ink-3">NetCashProvidedByUsedInOperatingActivities</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
