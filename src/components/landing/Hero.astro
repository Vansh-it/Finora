---
import SearchBar from '../search/SearchBar.tsx';
import { heroExamples } from '../../data/site';
---

<section id="top" data-hero-search class="relative overflow-hidden border-b border-hairline bg-canvas">
  <div class="mesh absolute inset-x-0 top-0 h-[620px] opacity-80 blur-3xl" aria-hidden="true"></div>
  <div class="absolute inset-x-0 top-0 h-[620px] bg-gradient-to-b from-transparent to-canvas" aria-hidden="true"></div>

  <div class="relative mx-auto flex max-w-[1400px] flex-col items-center px-6 pt-24 pb-20 text-center md:px-8 md:pt-32 md:pb-24">
    <span class="inline-flex items-center gap-2 rounded-full bg-canvas px-4 py-1.5 text-caption text-body shadow-l1">
      <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
      <span class="font-mono text-caption-mono text-ink">AI FINANCIAL RESEARCH &amp; INTELLIGENCE</span>
    </span>

    <h1 class="mt-8 max-w-4xl text-display-xl text-ink text-balance">
      Research US public companies. Verify every number.
    </h1>

    <p class="mt-6 max-w-2xl text-body-lg text-body text-pretty">
      Finora reads SEC filings for thousands of US-listed companies and turns them into
      institutional-grade financial metrics, executive summaries, and professional dashboards —
      with every figure traced back to the filing and page it came from.
    </p>

    <div class="mt-12 w-full max-w-3xl">
      <SearchBar client:load examples={heroExamples} />
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-caption text-mute">
      <span class="flex items-center gap-1.5">
        <svg class="text-up" width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8.5l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        No credit card required
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="text-up" width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8.5l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Grounded in SEC filings
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="text-up" width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8.5l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Export-ready PDFs
      </span>
    </div>

    <a
      href="#features"
      class="group mt-6 inline-flex items-center gap-1.5 text-caption text-body transition-colors hover:text-ink"
    >
      See how Finora works
      <svg
        class="text-mute transition-transform duration-200 group-hover:translate-x-0.5"
        width="11"
        height="11"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>
