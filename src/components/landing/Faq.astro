---
import FaqAccordion from '../ui/FaqAccordion.tsx';
import { faqs } from '../../data/site';
---

<section id="faq" class="border-b border-hairline bg-canvas-soft">
  <div class="mx-auto max-w-[820px] px-6 py-24 md:px-8 md:py-32">
    <p class="font-mono text-caption-mono uppercase tracking-wide text-accent">// faq</p>
    <h2 class="mt-4 max-w-2xl text-display-lg text-ink text-balance">
      Frequently asked questions.
    </h2>
    <div class="mt-12">
      <FaqAccordion client:load items={faqs} />
    </div>
  </div>
</section>
