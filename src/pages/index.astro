---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/landing/Hero.astro';
import StatsStrip from '../components/landing/StatsStrip.astro';
import Features from '../components/landing/Features.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import DashboardPreview from '../components/landing/DashboardPreview.astro';
import VerificationPreview from '../components/landing/VerificationPreview.astro';
import ExportPreview from '../components/landing/ExportPreview.astro';
import Testimonials from '../components/landing/Testimonials.astro';
import Faq from '../components/landing/Faq.astro';
import CtaFooter from '../components/landing/CtaFooter.astro';
---

<Layout
