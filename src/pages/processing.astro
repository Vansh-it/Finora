---
import Layout from '../layouts/Layout.astro';
import ProcessingFlow from '../components/flow/ProcessingFlow.tsx';

const params = Astro.url.searchParams;
const company = params.get('company') ?? 'Microsoft';
const from = params.get('from') ?? '2024';
const to = params.get('to') ?? '2025';
const objective = params.get('objective') ?? '';
const periodMode = params.get('period_mode') ?? 'specified';
const sessionId = params.get('session_id') ?? '';

const periodLabel = periodMode === 'latest'
  ? 'latest available financial reporting data'
  : `FY ${from} – ${to}`;
---

<Layout
  title="Analyzing — Finora"
  description="Finora is analyzing the company and building your verified dashboard."
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-0 lg:py-24">
    <div class="text-center">
      <p class="mb-3 font-mono text-xs tracking-[0.25em] text-ink-3 uppercase">// processing</p>
      <h1 class="font-serif text-4xl font-medium tracking-tight text-ink sm:text-5xl text-balance">Building your research.</h1>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-ink-2">
        Finora is reading public filings for <strong class="text-ink font-semibold">{company}</strong>,
        covering {periodLabel}.
      </p>
    </div>

    <div class="mt-12">
      <ProcessingFlow client:load company={company} sessionId={sessionId} />
    </div>

    <p class="mx-auto mt-10 max-w-xl text-center font-mono text-[10px] font-semibold tracking-[0.2em] text-ink-3 uppercase">
      {objective ? `Objective · ${objective}` : 'Objective · Calculate Key Financial Metrics'}
    </p>
  </div>
</Layout>
