---
import MobileMenu from './MobileMenu.tsx';
import NavbarUserMenu from './NavbarUserMenu.tsx';
import { navLinks } from '../../data/site';

const activeHref = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-ink/15 bg-paper/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-4 px-4 sm:px-6 lg:px-10">
    <a href="/" class="flex items-center gap-2 font-serif text-2xl font-semibold tracking-tight text-ink" aria-label="Finora home">
      <span class="inline-block h-3 w-3 bg-highlight" aria-hidden></span>
      Finora
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      <ul class="flex items-center gap-8">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={[
                'font-mono text-xs font-semibold tracking-[0.15em] uppercase transition-colors hover:text-ink',
                activeHref === link.href || (link.href.startsWith('/#') && activeHref === '/')
                  ? 'text-ink border-b-2 border-highlight pb-1'
                  : 'text-ink-2',
              ].join(' ')}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <NavbarUserMenu client:load />
      <div class="lg:hidden">
        <MobileMenu client:load links={navLinks} />
      </div>
    </div>
  </div>
</header>
