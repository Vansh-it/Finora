---
import Layout from '../layouts/Layout.astro';
import ChatApp from '../components/chat/ChatApp.tsx';
---

<Layout
  title="Financial Analyst Chat"
  description="Chat with Finora's AI financial analyst. Ask about any public company, financial metrics, or SEC filings."
>
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-10 lg:py-20">
    <div class="text-center">
      <p class="mb-3 font-mono text-xs tracking-[0.25em] text-ink-3 uppercase">// chat</p>
      <h1 class="font-serif text-4xl font-medium tracking-tight text-ink sm:text-5xl text-balance">Financial Analyst Chat</h1>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-ink-2">
        Ask about any public company's financials, SEC filings, metrics, or business analysis.
        15 messages per rolling 24-hour period.
      </p>
    </div>

    <div class="mt-12">
      <ChatApp client:load />
    </div>
  </div>
</Layout>
