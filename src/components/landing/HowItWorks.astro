---
import { steps } from '../../data/site';
---

<section id="how-it-works" class="border-b border-hairline bg-canvas">
  <div class="mx-auto max-w-[1400px] px-6 py-24 md:px-8 md:py-32">
    <p class="font-mono text-caption-mono uppercase tracking-wide text-accent">// how it works</p>
    <h2 class="mt-4 max-w-2xl text-display-lg text-ink text-balance">
      From question to verified dashboard in minutes.
    </h2>

    <ol class="mt-14 grid gap-10 md:grid-cols-4 md:gap-6">
      {
        steps.map((step, i) => (
          <li class="relative">
            {i < steps.length - 1 && (
              <svg class="absolute top-6 left-6 hidden h-px w-[calc(100%-3rem)] text-hairline md:block" aria-hidden="true">
                <line x1="0" y1="0" x2="100%" y2="0" stroke="currentColor" stroke-dasharray="4 4" />
              </svg>
            )}
            <div class="relative flex h-12 w-12 items-center justify-center rounded-md bg-ink font-mono text-caption-mono text-canvas">
              {step.index}
            </div>
            <h3 class="mt-6 text-display-sm text-ink">{step.title}</h3>
            <p class="mt-2 text-body-sm text-body">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 flex flex-wrap items-center gap-3">
      <a
        href="/#hero-search"
        class="inline-flex h-11 items-center rounded-pill bg-ink px-6 text-button-lg text-canvas transition-opacity hover:opacity-90"
      >
        Start a research
      </a>
      <a
        href="#previews"
        class="inline-flex h-11 items-center rounded-pill border border-hairline bg-canvas px-6 text-button-lg text-ink transition-colors hover:bg-canvas-soft"
      >
        See the output
      </a>
    </div>
  </div>
</section>
