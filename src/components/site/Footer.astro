---
const columns = [
  {
    label: 'Product',
    links: [
      { label: 'Dashboard', href: '/dashboard' },
      { label: 'Research', href: '/#hero-search' },
      { label: 'Chat', href: '/chat' },
      { label: 'Changelog', href: '#' },
    ],
  },
  {
    label: 'Resources',
    links: [
      { label: 'Documentation', href: '#' },
      { label: 'Methodology', href: '#' },
      { label: 'Data sources', href: '/dashboard#sources' },
      { label: 'Research blog', href: '#' },
    ],
  },
  {
    label: 'Company',
    links: [
      { label: 'About', href: '#' },
      { label: 'Careers', href: '#' },
      { label: 'Press', href: '#' },
      { label: 'Contact', href: '#' },
    ],
  },
  {
    label: 'Legal',
    links: [
      { label: 'Privacy', href: '#' },
      { label: 'Terms', href: '#' },
      { label: 'Security', href: '#' },
      { label: 'Disclaimers', href: '#' },
    ],
  },
];
---

<footer class="border-t border-hairline bg-canvas">
  <div class="mx-auto grid max-w-[1400px] grid-cols-2 gap-12 px-6 py-16 md:grid-cols-5 md:px-8">
    <div>
      <a href="/" class="flex items-center gap-2" aria-label="Finora home">
        <svg width="20" height="20" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <rect x="1" y="1" width="20" height="20" rx="6" fill="var(--ds-ink)" />
          <path
            d="M7.5 14.5c2.2-1.6 4.6-4.4 5-8M7.5 14.5c2.2-1.8 4.6-4.2 5-6"
            stroke="var(--ds-canvas)"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="12.8" cy="14.5" r="1.6" fill="var(--ds-accent)" />
        </svg>
        <span class="text-body-sm-strong text-ink">Finora</span>
      </a>
      <p class="mt-4 max-w-[240px] text-caption text-mute">
        AI financial research &amp; intelligence. Every number verified against
        the public filings it came from.
      </p>
    </div>

    {
      columns.map((col) => (
        <div>
          <h3 class="font-mono text-caption-mono uppercase tracking-wide text-body">
            {col.label}
          </h3>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-body-sm text-body transition-colors hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-hairline">
    <div class="mx-auto flex max-w-[1400px] flex-col gap-3 px-6 py-6 text-caption text-mute sm:flex-row sm:items-center sm:justify-between md:px-8">
      <p>© 2026 Finora Labs. All rights reserved.</p>
      <p class="font-mono text-caption-mono text-body">
        Research tool only — not investment advice.
      </p>
    </div>
  </div>
</footer>
