---
const bullets = ['Free research credits', 'No credit card required', 'Export-ready dashboards'];
---

<section class="relative overflow-hidden bg-ink">
  <div class="mesh absolute inset-0 opacity-50 blur-3xl" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-ink/60" aria-hidden="true"></div>

  <div class="relative mx-auto flex max-w-[900px] flex-col items-center px-6 py-28 text-center md:px-8 md:py-36">
    <p class="font-mono text-caption-mono uppercase tracking-wide text-cyan">// get started</p>
    <h2 class="mt-4 text-display-lg text-canvas text-balance">
      Research your first company in minutes.
    </h2>
    <p class="mt-4 max-w-xl text-body-lg text-canvas/70 text-pretty">
      Pick a company, choose your period, and get a verified financial
      dashboard — no spreadsheet required.
    </p>

    <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row">
      <a
        href="/"
        class="inline-flex h-12 items-center rounded-pill bg-canvas px-6 text-button-lg text-ink transition-opacity hover:opacity-90"
      >
        Start a research
      </a>
      <a
        href="#faq"
        class="inline-flex h-12 items-center rounded-pill border border-canvas/25 px-6 text-button-lg text-canvas transition-colors hover:border-canvas/50"
      >
        Read the FAQ
      </a>
    </div>

    <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-2">
      {
        bullets.map((b) => (
          <li class="flex items-center gap-2 text-caption text-canvas/60">
            <svg class="shrink-0 text-cyan" width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8.5l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {b}
          </li>
        ))
      }
    </ul>
  </div>
</section>
