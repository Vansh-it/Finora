---
const stats = [
  { value: '40,000+', label: 'Analysts & investors' },
  { value: '220,000+', label: 'Filings indexed' },
  { value: '26', label: 'Metrics per research' },
  { value: '100%', label: 'Verifiable numbers' },
];
---

<section class="border-b border-hairline bg-canvas">
  <div class="mx-auto grid max-w-[1400px] grid-cols-2 gap-8 px-6 py-12 md:grid-cols-4 md:px-8">
    {
      stats.map((s) => (
        <div class="flex flex-col items-center gap-1 text-center">
          <span class="text-display-md text-ink tabular-nums">{s.value}</span>
          <span class="text-caption text-mute">{s.label}</span>
        </div>
      ))
    }
  </div>
</section>
