---
import ThemeToggle from './ThemeToggle.tsx';
import MobileMenu from './MobileMenu.tsx';
import NavbarUserMenu from './NavbarUserMenu.tsx';
import { navLinks } from '../../data/site';

const activeHref = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between gap-4 px-6 md:px-8">
    <a href="/" class="flex items-center gap-2" aria-label="Finora home">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="20" height="20" rx="6" fill="var(--ds-ink)" />
        <path
          d="M7.5 14.5c2.2-1.6 4.6-4.4 5-8M7.5 14.5c2.2-1.8 4.6-4.2 5-6"
          stroke="var(--ds-canvas)"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="12.8" cy="14.5" r="1.6" fill="var(--ds-accent)" />
      </svg>
      <span class="text-body-sm-strong text-ink">Finora</span>
    </a>

    <nav class="hidden items-center md:flex" aria-label="Primary">
      <ul class="flex items-center gap-1">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={[
                  'rounded-full px-3 py-2 text-body-sm transition-colors',
                  activeHref === link.href || (link.href.startsWith('/#') && activeHref === '/')
                    ? 'bg-canvas-soft-2 text-ink'
                    : 'text-body hover:bg-canvas-soft-2 hover:text-ink',
                ].join(' ')}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle client:load />
      <NavbarUserMenu client:load />
      <div class="md:hidden">
        <MobileMenu client:load links={navLinks} />
      </div>
    </div>
  </div>
</header>
