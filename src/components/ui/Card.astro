---
interface Props {
  title: string;
  subtitle?: string;
  meta?: string;
}

const { title, subtitle, meta } = Astro.props;
---

<div class="rounded-lg bg-canvas p-6 shadow-l2">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-display-sm text-ink">{title}</h3>
      {subtitle && <p class="mt-1 text-caption text-mute">{subtitle}</p>}
    </div>
    {meta && <span class="shrink-0 font-mono text-caption-mono text-mute">{meta}</span>}
  </div>
  <div class="mt-5">
    <slot />
  </div>
</div>
