---
const rows = [
  { metric: 'Revenue', value: '$245.1B', yoy: '+15.7%' },
  { metric: 'Operating income', value: '$109.4B', yoy: '+23.6%' },
  { metric: 'Net income', value: '$88.1B', yoy: '+21.7%' },
  { metric: 'Free cash flow', value: '$74.2B', yoy: '+20.3%' },
  { metric: 'Diluted EPS', value: '$11.80', yoy: '+21.9%' },
];
---

<section class="border-b border-hairline bg-canvas-soft">
  <div class="mx-auto grid max-w-[1200px] items-center gap-14 px-6 py-24 md:grid-cols-2 md:px-8 md:py-32">
    <div class="order-2 md:order-1">
      <!-- Mock exported PDF sheet -->
      <div class="mx-auto max-w-sm rounded-sm bg-canvas p-8 shadow-l4">
        <div class="flex items-center justify-between border-b-2 border-ink pb-4">
          <div>
            <p class="text-display-sm text-ink">Microsoft Corporation</p>
            <p class="mt-1 font-mono text-caption-mono text-mute">Financial Dashboard · FY2024</p>
          </div>
          <span class="flex h-10 w-10 items-center justify-center rounded-md bg-ink text-caption-mono font-semibold text-canvas">MS</span>
        </div>
        <table class="mt-5 w-full border-collapse text-left">
          <thead>
            <tr>
              <th class="pb-2 font-mono text-caption-mono uppercase tracking-wide text-mute">Metric</th>
              <th class="pb-2 text-right font-mono text-caption-mono uppercase tracking-wide text-mute">Value</th>
              <th class="pb-2 text-right font-mono text-caption-mono uppercase tracking-wide text-mute">YoY</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr class="border-t border-hairline">
                  <td class="py-2.5 text-body-sm text-body">{r.metric}</td>
                  <td class="py-2.5 text-right font-mono text-body-sm-strong text-ink tabular-nums">{r.value}</td>
                  <td class="py-2.5 text-right font-mono text-body-sm text-up tabular-nums">{r.yoy}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mt-6 border-t border-hairline pt-4 font-mono text-caption-mono text-mute">
          Exported from Finora · 12 Aug 2026 · All figures verified against SEC filings
        </p>
      </div>
    </div>

    <div class="order-1 md:order-2">
      <p class="font-mono text-caption-mono uppercase tracking-wide text-accent">// export</p>
      <h2 class="mt-4 text-display-lg text-ink text-balance">
        One click to a professional PDF.
      </h2>
      <p class="mt-4 text-body-md text-body">
        When the research is done, export a clean, print-ready dashboard —
        KPIs, statements, and sources — formatted for your notes, your desk,
        or your client.
      </p>
      <ul class="mt-8 space-y-3">
        {
          [
            'Print-ready layout, consistent branding',
            'All verification metadata included',
            'Copy any table straight into your models',
          ].map((point) => (
            <li class="flex items-start gap-2.5 text-body-sm text-body">
              <svg class="mt-0.5 shrink-0 text-up" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8.5l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
