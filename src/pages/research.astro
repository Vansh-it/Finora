---
import Layout from '../layouts/Layout.astro';
import ResearchForm from '../components/search/ResearchForm.tsx';
import FlowIndicator from '../components/ui/FlowIndicator.astro';
---

<Layout
  title="Research a company"
  description="Pick a company, choose a fiscal period, and describe what you want to know. Finora handles the rest."
>
  <div class="mx-auto max-w-5xl px-6 py-16 md:px-8 md:py-24">
    <div class="flex justify-center">
      <FlowIndicator active={1} />
    </div>

    <div class="mt-12 text-center">
      <p class="font-mono text-caption-mono uppercase tracking-wide text-accent">// research</p>
      <h1 class="mt-4 text-display-lg text-ink text-balance">What would you like to research?</h1>
      <p class="mx-auto mt-4 max-w-xl text-body-md text-body">
        Name the company, the fiscal period, and the objective. This phase uses
        dummy interactions — the flow is fully wired.
      </p>
    </div>

    <div class="mt-12">
      <ResearchForm client:load />
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {
        [
          { title: 'Company search', body: 'Any public US-listed company — try Microsoft, Nvidia, or Apple.' },
          { title: 'Date range', body: 'Choose the fiscal years you care about, from 2020 onward.' },
          { title: 'Objective', body: 'Describe the metrics or focus areas you want analyzed.' },
        ].map((c) => (
          <div class="rounded-lg bg-canvas p-5 shadow-l1">
            <h2 class="text-body-sm-strong text-ink">{c.title}</h2>
            <p class="mt-1.5 text-caption text-mute">{c.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
