---
import Layout from '../layouts/Layout.astro';
import SignInForm from '../components/auth/SignInForm.tsx';
---

<Layout
  title="Sign In"
  description="Sign in to your Finora account to continue researching."
>
  <div class="mx-auto max-w-md px-6 py-16 md:px-8 md:py-24">
    <div class="text-center">
      <p class="font-mono text-caption-mono uppercase tracking-wide text-accent">// sign in</p>
      <h1 class="mt-4 text-display-md text-ink text-balance">Welcome back</h1>
      <p class="mt-3 text-body-sm text-body">
        Sign in to continue your research and chat sessions.
      </p>
    </div>

    <div class="mt-10">
      <SignInForm client:load />
    </div>

    <p class="mt-8 text-center text-caption text-mute">
      Don't have an account?{' '}
      <a href="/signup" class="text-accent transition-colors hover:text-ink">
        Sign up free
      </a>
    </p>
  </div>
</Layout>
