# Finora Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# NVIDIA Nemotron 3.5 — the only LLM provider.
# Get your key at https://build.nvidia.com

NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Tavily Search ──────────────────────────────────────────────────────────────
# Web search API for research source discovery.
# Get your key at https://tavily.com

TAVILY_API_KEY=your_tavily_api_key_here

# ── Jina Reader ────────────────────────────────────────────────────────────────
# Web page content extraction for reading source documents.
# Get your key at https://jina.ai

JINA_API_KEY=your_jina_api_key_here

# ── SEC/EDGAR ─────────────────────────────────────────────────────────────────
# User-Agent string for SEC EDGAR requests.
# SEC requires a valid User-Agent header for automated access.
# Format: "AppName YourEmail@example.com"

FINORA_SEC_USER_AGENT=Finora Research Tool your_email@example.com

# ── Twelve Data ───────────────────────────────────────────────────────────────
# Stock market data API (prices, fundamentals, etc.).
# Get your key at https://twelvedata.com

TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave empty for development (defaults to localhost:4321).

CORS_ORIGINS=

# ── Flask ─────────────────────────────────────────────────────────────────────
# Set to "false" in production.
FLASK_DEBUG=true

# Server port (default 8000).
PORT=8000
