---
const COLUMNS = [
  {
    title: 'Product',
    links: [
      { label: 'Research', href: '/research' },
      { label: 'Dashboard', href: '/dashboard' },
      { label: 'Chat', href: '/chat' },
    ],
  },
  {
    title: 'Research',
    links: [
      { label: 'Methodology', href: '/methodology' },
      { label: 'Data Sources', href: '/dashboard' },
    ],
  },
  {
    title: 'Company',
    links: [{ label: 'About', href: '/methodology' }],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy' },
      { label: 'Terms', href: '/terms' },
    ],
  },
];
---

<footer class="border-t border-ink/15 bg-paper-2">
  <div class="mx-auto max-w-[1440px] px-4 py-14 sm:px-6 lg:px-10">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div>
        <div class="flex items-center gap-2 font-serif text-4xl font-semibold tracking-tight text-ink">
          <span class="inline-block h-3.5 w-3.5 bg-highlight" aria-hidden></span>
          Finora.
        </div>
        <p class="mt-3 max-w-xs font-mono text-xs tracking-[0.1em] text-ink-3 uppercase">
          Financial research with receipts.
        </p>
      </div>

      {COLUMNS.map((col) => (
        <div>
          <h4 class="mb-4 font-mono text-xs font-bold tracking-[0.2em] text-ink uppercase">{col.title}</h4>
          <ul class="space-y-2.5">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-ink-2 transition-colors hover:text-ink hover:underline">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-ink/15 pt-6 text-xs text-ink-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono tracking-wide">&copy; 2026 FINORA LABS</p>
      <p class="max-w-md">Research tool only — not investment advice. Data derived from public filings and market sources.</p>
    </div>
  </div>
</footer>
