---
const rawValues = [
  { label: 'Revenue', value: '$245.1B' },
  { label: 'Cost of revenue', value: '$75.6B' },
];
---

<section class="border-b border-hairline bg-canvas">
  <div class="mx-auto grid max-w-[1200px] items-center gap-14 px-6 py-24 md:grid-cols-2 md:px-8 md:py-32">
    <div>
      <p class="font-mono text-caption-mono uppercase tracking-wide text-accent">// verification</p>
      <h2 class="mt-4 text-display-lg text-ink text-balance">
        Trust the number. See the math.
      </h2>
      <p class="mt-4 text-body-md text-body">
        Every metric on every Finora dashboard carries a verification trail.
        Click the shield on any KPI to open the calculation: the formula, the
        raw values pulled from the filing, and the exact page it came from.
      </p>
      <ul class="mt-8 space-y-3">
        {
          [
            'Formula and inputs, side by side',
            'Source document with page number',
            'Plain-English calculation explanation',
          ].map((point) => (
            <li class="flex items-start gap-2.5 text-body-sm text-body">
              <svg class="mt-0.5 shrink-0 text-up" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8.5l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {point}
            </li>
          ))
        }
      </ul>
      <a
        href="/dashboard"
        class="mt-10 inline-flex h-11 items-center rounded-pill bg-ink px-6 text-button-lg text-canvas transition-opacity hover:opacity-90"
      >
        Audit a live KPI
      </a>
    </div>

    <!-- Mock verification modal -->
    <div class="relative" aria-hidden="true">
      <div class="absolute -inset-4 rounded-2xl bg-accent/5 blur-2xl"></div>
      <div class="relative rounded-lg bg-canvas p-6 shadow-l5 sm:p-8">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="flex items-center gap-2 text-caption text-mute">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 1.8l5.2 2v4.1c0 3.2-2.2 5.3-5.2 6.3-3-1-5.2-3.1-5.2-6.3V3.8L8 1.8z" stroke="var(--ds-accent)" stroke-width="1.4" stroke-linejoin="round" />
                <path d="M5.8 8l1.6 1.6 2.8-3.2" stroke="var(--ds-accent)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Verified calculation
            </p>
            <p class="mt-1 text-display-sm text-ink">Gross Margin</p>
          </div>
          <span class="flex h-7 w-7 items-center justify-center rounded-sm border border-hairline text-mute">
            <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
        </div>

        <p class="mt-5 text-display-md text-ink tabular-nums">69.2%</p>

        <div class="mt-6 space-y-5">
          <div>
            <p class="font-mono text-caption-mono uppercase tracking-wide text-mute">Formula</p>
            <p class="mt-1.5 rounded-sm bg-canvas-soft p-3 font-mono text-code text-ink">
              (Revenue − cost of revenue) ÷ revenue
            </p>
          </div>
          <div>
            <p class="font-mono text-caption-mono uppercase tracking-wide text-mute">Raw values</p>
            <dl class="mt-2 divide-y divide-hairline border-y border-hairline">
              {
                rawValues.map((v) => (
                  <div class="flex items-center justify-between gap-4 py-2.5">
                    <dt class="text-body-sm text-body">{v.label}</dt>
                    <dd class="font-mono text-body-sm-strong text-ink tabular-nums">{v.value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <div class="flex items-start gap-3 rounded-sm border border-hairline bg-canvas-soft p-3">
            <svg class="mt-0.5 shrink-0 text-accent" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2.5 13.5V5L8 2l5.5 3v8.5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
              <path d="M5.5 13.5V8h5v5.5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
            </svg>
            <div>
              <p class="text-body-sm-strong text-ink">Form 10-K FY2024 · Income Statement</p>
              <p class="mt-0.5 font-mono text-caption-mono text-mute">p. 42</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
