---
import Layout from '../layouts/Layout.astro';
import FlowIndicator from '../components/ui/FlowIndicator.astro';
import PermissionCard from '../components/flow/PermissionCard.tsx';

const params = Astro.url.searchParams;
const company = params.get('company') ?? 'Microsoft';
const from = params.get('from') ?? '2024';
const to = params.get('to') ?? '2025';
const objective = params.get('objective') ?? '';
const periodMode = params.get('period_mode') ?? 'specified';
---

<Layout
  title="Grant permission"
  description="Finora needs a few permissions to read public filings and build your research."
>
  <div class="mx-auto max-w-2xl px-6 py-16 md:px-8 md:py-24">
    <div class="flex justify-center">
      <FlowIndicator active={2} />
    </div>

    <div class="mt-12">
      <PermissionCard
        client:load
        company={company}
        fromYear={from}
        toYear={to}
        objective={objective}
        periodMode={periodMode}
      />
    </div>
  </div>
</Layout>
