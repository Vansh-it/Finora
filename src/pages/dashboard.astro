---
import Layout from '../layouts/Layout.astro';
import Dashboard from '../components/dashboard/Dashboard.tsx';
import VerificationModal from '../components/dashboard/VerificationModal.tsx';
import FlowIndicator from '../components/ui/FlowIndicator.astro';

const sessionId = Astro.url.searchParams.get('session_id');
const companyName = Astro.url.searchParams.get('company') || 'Company Research';
---

<Layout
  title={sessionId ? `Dashboard — ${companyName}` : 'Dashboard — Finora'}
  description={`Financial dashboard for ${companyName} with verified KPIs, statements, and sources.`}
>
  <div class="mx-auto max-w-[1400px] px-6 py-16 md:px-8 md:py-20">
    <div class="flex justify-center">
      <FlowIndicator active={5} />
    </div>

    <div class="mt-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="font-mono text-caption-mono uppercase tracking-wide text-accent">// dashboard</p>
        <h1 class="mt-3 text-display-lg text-ink">{companyName}</h1>
        {sessionId && (
          <p class="mt-1 font-mono text-caption-mono text-mute">Live research data</p>
        )}
      </div>
    </div>

    <div class="mt-8">
      <Dashboard client:load />
    </div>

    <p class="mt-10 text-center text-caption text-mute">
      Click the shield icon on any KPI to open its verification — formula, raw values, source, and page.
    </p>
  </div>

  <VerificationModal client:load />
</Layout>
